# Empty keeps local REST endpoints unauthenticated. Set a long random value for protected deployments.
AXION_API_KEY=
AXION_HTTP_PORT=8080
AXION_GRPC_PORT=50051
AXION_WEB_PORT=3000
RUST_LOG=axion=info,tower_http=info
# Optional OTLP/gRPC endpoint, for example http://localhost:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=axion-server

